# Copy to .env and adjust. Never commit real keys.
# Defaults to SQLite at data/eduadapt.db (absolute path computed by the app). any SQLAlchemy URL works, e.g. PostgreSQL after `pip install psycopg[binary]`:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/eduadapt
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# AI tutor: mock = deterministic, offline, no key needed. real = call an LLM (falls back to mock on error)
AI_MODE=mock
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Mastery thresholds (0-100)
UNLOCK_THRESHOLD=60
COMPLETED_THRESHOLD=70
MASTERED_THRESHOLD=85

# Optional override of the hybrid recommender weights (normalised automatically)
# RECOMMENDATION_WEIGHTS={"knowledge_gap":0.30,"goal_relevance":0.20,"prerequisite_priority":0.15,"recent_performance":0.10,"interest_match":0.10,"difficulty_fit":0.10,"feedback":0.05}

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
